{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mandate-d1-policy-integration",
  "main": "./d1-policy-test-worker.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{
    "binding": "MCP_ACTIVITY_DB",
