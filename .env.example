# Copy to .env.local for local backend development. Never commit actual credentials.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MANDATE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
MANDATE_AGENT_PRIVATE_KEY=0x<64-hex-character-local-test-key>
MANDATE_DEPLOYER_PRIVATE_KEY=

# Google AI Studio backend-only key; never add this to a VITE_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Public static console configuration
VITE_MONAD_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MANDATE_DEPLOYMENT_BLOCK=0
VITE_MANDATE_MCP_URL=https://mandate-console.pages.dev/mcp

# Cloudflare Pages runtime secrets (configure in the Pages dashboard; never VITE_ vars)
# MCP_BEARER_TOKEN=<random 32+ byte client token>
# MCP_ALLOWED_ORIGINS=https://mandate-console.pages.dev

# Local stdio MCP starts with no tools unless explicit capabilities are granted.
# Set only the scopes this local MCP client needs; unbound principal access is denied by default.
# MCP_GRANTED_SCOPES=mandate:read mandate:propose
# MCP_PRINCIPAL_ADDRESS=0x<40-hex-character-wallet-address>
# Set true only for an intentionally configured local operator server. The hosted route
# enables this only for the dedicated MCP_BEARER_TOKEN operator credential.
# MCP_ALLOW_UNBOUND_PRINCIPAL=false
