{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "noImplicitAny": true, "strictNullChecks": true, "strictFunctionTypes": true,
    "strictBindCallApply": true, "strictPropertyInitialization": true, "noImplicitThis": true,
    "noImplicitReturns": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "jsx": "react-jsx", "composite": true, "types": ["vite/client"]
  },
  "references": [{ "path": "../../packages/policy" }, { "path": "../../packages/mandate-sdk" }],
  "include": ["src"]
}
