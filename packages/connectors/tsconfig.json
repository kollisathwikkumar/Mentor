{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noImplicitAny": true, "strictNullChecks": true,
    "strictFunctionTypes": true, "strictBindCallApply": true,
    "strictPropertyInitialization": true, "noImplicitThis": true,
    "noImplicitReturns": true, "noUncheckedIndexedAccess": true,
    "declaration": true, "composite": true, "outDir": "dist", "rootDir": "src", "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
