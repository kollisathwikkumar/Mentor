  "compilerOptions": { "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true, "noImplicitAny": true, "strictNullChecks": true, "strictFunctionTypes": true, "strictBindCallApply": true, "strictPropertyInitialization": true, "noImplicitThis": true, "noImplicitReturns": true, "noUncheckedIndexedAccess": true, "composite": true, "declaration": true, "outDir": "dist", "rootDir": "src", "skipLibCheck": true },
